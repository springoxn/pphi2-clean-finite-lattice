import AImathPPhi2Clean.ConcreteLatticeCovariance
import AImathPPhi2Clean.FiniteLiftGaussianMoment
noncomputable section
namespace Pphi2Clean.Continuum
open MeasureTheory ProbabilityTheory
/-- A finite Gaussian configuration generated by a concrete covariance factor.
The independent standard normals are enumerated by `Fin (card ι)`. -/
def covarianceConfiguration {ι : Type*} [Fintype ι]
    (T : (ι → ℝ) →L[ℝ] EuclideanSpace ℝ ι)
    (z : Fin (Fintype.card ι) → ℝ) : WeakDual ℝ (ι → ℝ) := by
  let L : (ι → ℝ) →ₗ[ℝ] ℝ :=
    { toFun := fun f => ∑ k, z k * (T f) ((Fintype.equivFin ι).symm k)
      map_add' := by intro f g; simp [mul_add, Finset.sum_add_distrib]
      map_smul' := by
        intro r f
        simp [Finset.mul_sum, mul_assoc, mul_left_comm, mul_comm] }
  exact StrongDual.toWeakDual { L with cont := L.continuous_of_finiteDimensional }
@[simp] theorem covarianceConfiguration_apply {ι : Type*} [Fintype ι]
    (T : (ι → ℝ) →L[ℝ] EuclideanSpace ℝ ι)
    (z : Fin (Fintype.card ι) → ℝ) (f : ι → ℝ) :
    covarianceConfiguration T z f = ∑ k, z k * (T f) ((Fintype.equivFin ι).symm k) := by
  rfl

theorem covarianceConfiguration_second_moment {ι : Type*} [Fintype ι]
    (T : (ι → ℝ) →L[ℝ] EuclideanSpace ℝ ι) (f : ι → ℝ) :
    ∫ z, (covarianceConfiguration T z f)^2
      ∂Pphi2Clean.LatticeGaussian.productGaussian (Fintype.card ι) 1 =
      @inner ℝ (EuclideanSpace ℝ ι) _ (T f) (T f) := by
  have h := Pphi2Clean.LatticeGaussian.productGaussian_linear_second_moment_eq
    (Fintype.card ι) 1 (fun k => (T f) ((Fintype.equivFin ι).symm k))
  have he := (Fintype.equivFin ι).symm.sum_comp (fun x => ((T f) x)^2)
  rw [real_inner_self_eq_norm_sq, PiLp.norm_sq_eq_of_L2]
  simp only [Real.norm_eq_abs, sq_abs]
  rw [← he]
  simpa [covarianceConfiguration_apply, mul_comm] using h

/-- The sampled finite Gaussian evaluation belongs to L². -/
theorem covarianceConfiguration_memLp {ι : Type*} [Fintype ι]
    (T : (ι → ℝ) →L[ℝ] EuclideanSpace ℝ ι) (f : ι → ℝ) :
    MemLp (fun z => covarianceConfiguration T z f) 2
      (Pphi2Clean.LatticeGaussian.productGaussian (Fintype.card ι) 1) := by
  simp_rw [covarianceConfiguration_apply]
  apply memLp_finsetSum Finset.univ
  intro k hk
  exact ((memLp_id_gaussianReal (μ := 0) (v := 1) 2).comp_measurePreserving
    (measurePreserving_eval (fun _ : Fin (Fintype.card ι) => gaussianReal 0 1) k)).mul_const _

theorem covarianceConfiguration_covariance {ι : Type*} [Fintype ι]
    (T : (ι → ℝ) →L[ℝ] EuclideanSpace ℝ ι) (f g : ι → ℝ) :
    ∫ z, covarianceConfiguration T z f * covarianceConfiguration T z g
      ∂Pphi2Clean.LatticeGaussian.productGaussian (Fintype.card ι) 1 =
      @inner ℝ (EuclideanSpace ℝ ι) _ (T f) (T g) := by
  let μ := Pphi2Clean.LatticeGaussian.productGaussian (Fintype.card ι) 1
  have hf := covarianceConfiguration_memLp T f
  have hg := covarianceConfiguration_memLp T g
  have hp : Integrable (fun z => covarianceConfiguration T z f * covarianceConfiguration T z g) μ :=
    hf.integrable_mul hg
  have hid : (∫ z, (covarianceConfiguration T z (f + g))^2 ∂μ) =
      (∫ z, (covarianceConfiguration T z f)^2 ∂μ) +
      (∫ z, (covarianceConfiguration T z g)^2 ∂μ) +
      2 * (∫ z, covarianceConfiguration T z f * covarianceConfiguration T z g ∂μ) := by
    calc
      _ = ∫ z, ((covarianceConfiguration T z f)^2 +
          (covarianceConfiguration T z g)^2) +
          2 * (covarianceConfiguration T z f * covarianceConfiguration T z g) ∂μ := by
        apply integral_congr_ae
        filter_upwards [] with z
        rw [map_add]
        ring
      _ = _ := by
        have hs : Integrable (fun z => (covarianceConfiguration T z f)^2 +
            (covarianceConfiguration T z g)^2) μ := by
          exact hf.integrable_sq.add hg.integrable_sq
        rw [integral_add hs (hp.const_mul 2),
          integral_add hf.integrable_sq hg.integrable_sq, integral_const_mul]
  have hfg := covarianceConfiguration_second_moment T (f + g)
  have hff := covarianceConfiguration_second_moment T f
  have hgg := covarianceConfiguration_second_moment T g
  change (∫ z, covarianceConfiguration T z f * covarianceConfiguration T z g ∂μ) = _
  change (∫ z, (covarianceConfiguration T z (f+g))^2 ∂μ) = _ at hfg
  change (∫ z, (covarianceConfiguration T z f)^2 ∂μ) = _ at hff
  change (∫ z, (covarianceConfiguration T z g)^2 ∂μ) = _ at hgg
  rw [hfg, hff, hgg, map_add, inner_add_left, inner_add_right, inner_add_right] at hid
  have hc : @inner ℝ (EuclideanSpace ℝ ι) _ (T g) (T f) =
      @inner ℝ (EuclideanSpace ℝ ι) _ (T f) (T g) := real_inner_comm _ _
  rw [hc] at hid
  linarith

/-- The finite-site lift tests the configuration on the sampled test field. -/
theorem finiteSiteEmbedLift_eval_eq {ι E : Type*} [Fintype ι] [DecidableEq ι]
    [AddCommGroup E] [Module ℝ E] [TopologicalSpace E] [IsTopologicalAddGroup E]
    (eval : ι → E →L[ℝ] ℝ) (ω : WeakDual ℝ (ι → ℝ)) (f : E) :
    finiteSiteEmbedLift eval ω f = ω (fun x => eval x f) := by
  rw [finiteSiteEmbedLift_eval]
  have he : (fun x => eval x f) = ∑ x : ι, (eval x f) • (Pi.single x (1 : ℝ) : ι → ℝ) := by
    funext y
    simp [Pi.single_apply]
  rw [he, map_sum]
  simp [mul_comm]

open Pphi2Clean.UpstreamLattice
/-- Exact finite-lattice covariance for the migrated GJ factor. -/
theorem latticeCovarianceGJ_gaussian_covariance
    (d N : ℕ) [NeZero N] (a mass : ℝ) (ha : 0 < a) (hmass : 0 < mass)
    (f g : FinLatticeSites d N → ℝ) :
    ∫ z, covarianceConfiguration (latticeCovarianceGJ d N a mass ha hmass) z f *
      covarianceConfiguration (latticeCovarianceGJ d N a mass ha hmass) z g
      ∂Pphi2Clean.LatticeGaussian.productGaussian (Fintype.card (FinLatticeSites d N)) 1 =
      (a^d : ℝ)⁻¹ * ∑ k : FinLatticeSites d N,
        (massEigenvalues d N a mass k)⁻¹ *
          (∑ x, (massEigenvectorBasis d N a mass k : EuclideanSpace ℝ _) x * f x) *
          (∑ x, (massEigenvectorBasis d N a mass k : EuclideanSpace ℝ _) x * g x) := by
  rw [covarianceConfiguration_covariance, latticeCovarianceGJ_inner, latticeCovariance_inner]

/-- The actual periodic-lattice GJ Gaussian has the expected lifted second moment. -/
theorem latticeCovarianceGJ_lift_second_moment
    {E : Type*} [AddCommGroup E] [Module ℝ E] [TopologicalSpace E] [IsTopologicalAddGroup E]
    (d N : ℕ) [NeZero N] (a mass : ℝ) (ha : 0 < a) (hmass : 0 < mass)
    (eval : FinLatticeSites d N → E →L[ℝ] ℝ) (f : E) :
    ∫ z, (finiteSiteEmbedLift eval
      (covarianceConfiguration (latticeCovarianceGJ d N a mass ha hmass) z) f)^2
      ∂Pphi2Clean.LatticeGaussian.productGaussian (Fintype.card (FinLatticeSites d N)) 1 =
      (a^d : ℝ)⁻¹ * ∑ k : FinLatticeSites d N,
        (massEigenvalues d N a mass k)⁻¹ *
          (∑ x, (massEigenvectorBasis d N a mass k : EuclideanSpace ℝ _) x * eval x f)^2 := by
  simp_rw [finiteSiteEmbedLift_eval_eq, pow_two]
  rw [latticeCovarianceGJ_gaussian_covariance]
  congr 1
  apply Finset.sum_congr rfl
  intro k hk
  ring

/-- Cylindrical measurability of the sampled configuration. -/
theorem covarianceConfiguration_measurable {ι : Type*} [Fintype ι]
    (T : (ι → ℝ) →L[ℝ] EuclideanSpace ℝ ι) :
    Measurable (covarianceConfiguration T) := by
  rw [measurable_iff_comap_le]
  show (MeasurableSpace.comap (fun ω f => ω f) MeasurableSpace.pi).comap
    (covarianceConfiguration T) ≤ _
  rw [MeasurableSpace.comap_comp]
  apply (measurable_pi_lambda _ ?_).comap_le
  intro f
  change Measurable (fun z => covarianceConfiguration T z f)
  simp_rw [covarianceConfiguration_apply]
  exact Finset.measurable_sum _ (fun k hk => (measurable_pi_apply k).mul_const _)

/-- The actual finite-dimensional Gaussian law on the cylindrical weak dual. -/
def finiteCovarianceGaussianMeasure {ι : Type*} [Fintype ι]
    (T : (ι → ℝ) →L[ℝ] EuclideanSpace ℝ ι) : Measure (WeakDual ℝ (ι → ℝ)) :=
  (Pphi2Clean.LatticeGaussian.productGaussian (Fintype.card ι) 1).map
    (covarianceConfiguration T)

instance finiteCovarianceGaussianMeasure_probability {ι : Type*} [Fintype ι]
    (T : (ι → ℝ) →L[ℝ] EuclideanSpace ℝ ι) :
    IsProbabilityMeasure (finiteCovarianceGaussianMeasure T) := by
  unfold finiteCovarianceGaussianMeasure
  infer_instance

theorem finiteCovarianceGaussianMeasure_covariance {ι : Type*} [Fintype ι]
    (T : (ι → ℝ) →L[ℝ] EuclideanSpace ℝ ι) (f g : ι → ℝ) :
    ∫ ω, ω f * ω g ∂finiteCovarianceGaussianMeasure T =
      @inner ℝ (EuclideanSpace ℝ ι) _ (T f) (T g) := by
  unfold finiteCovarianceGaussianMeasure
  have hf : Measurable (fun ω : WeakDual ℝ (ι → ℝ) => ω f) :=
    (measurable_pi_apply f).comp (comap_measurable _)
  have hg : Measurable (fun ω : WeakDual ℝ (ι → ℝ) => ω g) :=
    (measurable_pi_apply g).comp (comap_measurable _)
  have hm : Measurable (fun ω : WeakDual ℝ (ι → ℝ) => ω f * ω g) := hf.mul hg
  rw [integral_map (covarianceConfiguration_measurable T).aemeasurable hm.aestronglyMeasurable]
  exact covarianceConfiguration_covariance T f g

/-- The original clean `latticeEmbedLift` has the exact source Gaussian moment. -/
theorem latticeEmbedLift_covariance_second_moment
    {n : ℕ} {E : Type*} [AddCommGroup E] [Module ℝ E]
    [TopologicalSpace E] [IsTopologicalAddGroup E]
    (T : (Fin n → ℝ) →L[ℝ] EuclideanSpace ℝ (Fin n))
    (eval : Fin n → E →L[ℝ] ℝ) (f : E) :
    ∫ ω, (latticeEmbedLift eval ω f)^2 ∂finiteCovarianceGaussianMeasure T =
      @inner ℝ (EuclideanSpace ℝ (Fin n)) _
        (T (latticeTestField eval f)) (T (latticeTestField eval f)) := by
  simp_rw [latticeEmbedLift_eval_eq, pow_two]
  exact finiteCovarianceGaussianMeasure_covariance T _ _

/-- Exact second moment in the law pushed forward by the clean lift. -/
theorem latticeEmbedLift_pushforward_second_moment
    {n : ℕ} {E : Type*} [AddCommGroup E] [Module ℝ E]
    [TopologicalSpace E] [IsTopologicalAddGroup E]
    (T : (Fin n → ℝ) →L[ℝ] EuclideanSpace ℝ (Fin n))
    (eval : Fin n → E →L[ℝ] ℝ) (f : E) :
    ∫ ω : WeakDual ℝ E, (ω f)^2
      ∂(finiteCovarianceGaussianMeasure T).map (latticeEmbedLift eval) =
      @inner ℝ (EuclideanSpace ℝ (Fin n)) _
        (T (latticeTestField eval f)) (T (latticeTestField eval f)) := by
  have hm : Measurable (fun ω : WeakDual ℝ E => (ω f)^2) :=
    ((measurable_pi_apply f).comp (comap_measurable _)).pow_const 2
  rw [integral_map (latticeEmbedLift_measurable eval).aemeasurable hm.aestronglyMeasurable]
  exact latticeEmbedLift_covariance_second_moment T eval f

theorem finiteSiteEmbedLift_measurable {ι E : Type*} [Fintype ι] [DecidableEq ι]
    [AddCommGroup E] [Module ℝ E] [TopologicalSpace E] [IsTopologicalAddGroup E]
    (eval : ι → E →L[ℝ] ℝ) : Measurable (finiteSiteEmbedLift eval) := by
  rw [measurable_iff_comap_le]
  show (MeasurableSpace.comap (fun ω f => ω f) MeasurableSpace.pi).comap
    (finiteSiteEmbedLift eval) ≤ _
  rw [MeasurableSpace.comap_comp]
  apply (measurable_pi_lambda _ ?_).comap_le
  intro f
  change Measurable (fun ω => finiteSiteEmbedLift eval ω f)
  simp_rw [finiteSiteEmbedLift_eval_eq]
  exact (measurable_pi_apply (fun x => eval x f)).comp (comap_measurable _)

/-- Exact GJ second moment in the pushed-forward finite periodic-lattice law. -/
theorem latticeCovarianceGJ_pushforward_second_moment
    {E : Type*} [AddCommGroup E] [Module ℝ E] [TopologicalSpace E] [IsTopologicalAddGroup E]
    (d N : ℕ) [NeZero N] (a mass : ℝ) (ha : 0 < a) (hmass : 0 < mass)
    (eval : FinLatticeSites d N → E →L[ℝ] ℝ) (f : E) :
    ∫ ω : WeakDual ℝ E, (ω f)^2
      ∂(finiteCovarianceGaussianMeasure (latticeCovarianceGJ d N a mass ha hmass)).map
        (finiteSiteEmbedLift eval) =
      (a^d : ℝ)⁻¹ * ∑ k : FinLatticeSites d N,
        (massEigenvalues d N a mass k)⁻¹ *
          (∑ x, (massEigenvectorBasis d N a mass k : EuclideanSpace ℝ _) x * eval x f)^2 := by
  have hm : Measurable (fun ω : WeakDual ℝ E => (ω f)^2) :=
    ((measurable_pi_apply f).comp (comap_measurable _)).pow_const 2
  rw [integral_map (finiteSiteEmbedLift_measurable eval).aemeasurable hm.aestronglyMeasurable]
  simp_rw [finiteSiteEmbedLift_eval_eq, pow_two]
  rw [finiteCovarianceGaussianMeasure_covariance, latticeCovarianceGJ_inner, latticeCovariance_inner]
  congr 1
  apply Finset.sum_congr rfl
  intro k hk
  ring
end Pphi2Clean.Continuum
