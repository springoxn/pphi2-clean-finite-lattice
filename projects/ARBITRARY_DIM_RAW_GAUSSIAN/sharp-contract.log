sharp_actual_raw_gaussian_weak_convergence : ∀ (d : ℕ) (hd : 0 < d) (s : ℝ) (hs : ↑d / 2 < s) (L mass : ℝ) (hL : 0 < L)
  (hmass : 0 < mass),
  ∃! ν,
    Tendsto (actualTargetProbabilityMeasure_fixedVolume L mass hL hmass) atTop (𝓝 ν) ∧
      ∀ (t : Finset Index), ν.map (targetFiniteCoordinates t) = targetFiniteGaussianLimit t L mass hL hmass
sharp_target_weight : ∀ (d : ℕ) (hd : 0 < d) (s : ℝ) (hs : ↑d / 2 < s) (k : Fin d → ℤ),
  targetWeight k = (1 + ‖k‖) ^ (-2 * s)
@actualRawAtomicLift_eq_rawAtomicFourierLift : ∀ [inst : Parameters] (N : ℕ) [inst_1 : NeZero N] (a L : ℝ) (hL : 0 < L)
  (ξ : FiniteConfig N) (k : Index),
  actualRawAtomicLift N a L hL ξ k = ArbitraryDimRawLift.rawAtomicFourierLift N a L (rawLiftSourceFielddimension ξ) k
@actualTargetLift_apply : ∀ [inst : Parameters] (N : ℕ) [inst_1 : NeZero N] (a L : ℝ) (ha : 0 < a) (hL : 0 < L)
  (ξ : FiniteConfig N) (k : Index),
  ↑(actualTargetLift N a L ha hL ξ) k = ↑√(targetWeight k) * actualRawAtomicLift N a L hL ξ k
@targetFiniteGaussianLimit_isGaussian : ∀ [inst : Parameters] (s : Finset Index) (L mass : ℝ) (hL : 0 < L)
  (hmass : 0 < mass), IsGaussian ↑(targetFiniteGaussianLimit s L mass hL hmass)
