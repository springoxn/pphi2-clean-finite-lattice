Pphi2Clean.Continuum.periodic3DRawAtomicLift_integral_energy_hminusTwo_le (N : ℕ) [NeZero N] (a mass L : ℝ) (ha : 0 < a)
  (hmass : 0 < mass) (hvol : a * ↑N = L) (hL : 0 < L) :
  ∫ (ω : WeakDual ℝ (Fin (Fintype.card (Pphi2Clean.UpstreamLattice.FinLatticeSites 3 N)) → ℝ)),
      ∑' (k : Periodic3DIndex),
        periodic3DHminusTwoWeight k *
          ‖periodic3DRawAtomicLift N a L hL ω k‖ ^
            2 ∂finiteCovarianceGaussianMeasure (numberedLatticeCovarianceGJ 3 N a mass ha hmass) ≤
    2 * (mass⁻¹ ^ 2 * L ^ 3) * ∑' (k : Periodic3DIndex), periodic3DHminusTwoWeight k
