@Pphi2Clean.Continuum.fs4PhysicalFiniteMarginal_eq_resolventTarget : ∀ {m : ℕ} (L mass : ℝ) (hL : 0 < L)
  (hmass : 0 < mass) (js : Fin m → Pphi2Clean.Continuum.FS4GaussianRealCoordinateIndex),
  Function.Injective js →
    Pphi2Clean.Continuum.fs4PhysicalFiniteMarginal L mass js =
      Pphi2Clean.Continuum.periodicResolventTargetMeasure 4 m L mass hmass fun i =>
        Pphi2Clean.Continuum.fs4PhysicalCoordinateTest L hL (js i)
'Pphi2Clean.Continuum.fs4PhysicalFiniteMarginal_eq_resolventTarget' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
Pphi2Clean.Continuum.fs4HminusFour_probabilityMeasure_ext_of_real_finite_marginals : ∀
