  (∀ᵐ (x : ↥Pphi2Clean.Continuum.FS4HminusFourCompletion) ∂↑μ, x ∈ Pphi2Clean.Continuum.fs4HminusFourRealCarrier) →
    (∀ᵐ (x : ↥Pphi2Clean.Continuum.FS4HminusFourCompletion) ∂↑ν, x ∈ Pphi2Clean.Continuum.fs4HminusFourRealCarrier) →
      (∀ (m : ℕ) (js : Fin m → Pphi2Clean.Continuum.FS4GaussianRealCoordinateIndex),
          Function.Injective js →
